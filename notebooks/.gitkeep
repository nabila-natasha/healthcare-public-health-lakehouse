     ]
    }
   ],
   "source": [
    "# Export feature importance for downstream analytics\n",
    "\n",
    "feature_importance_output = importance_df[\n",
    "    [\"feature\", \"importance\"]\n",
    "].copy()\n",
    "\n",
    "feature_importance_output.to_parquet(\n",
    "    \"/Volumes/workspace/default/openfda_ml/openfda_feature_importance.parquet\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Feature importance exported:\",\n",
    "    feature_importance_output.shape\n",
    ")"
   ]
  },
