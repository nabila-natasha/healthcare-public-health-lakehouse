    "# Build the final anomaly output for downstream analytics\n",
    "\n",
    "anomaly_output = anomaly_results[\n",
    "    [\n",
    "        \"anomaly_prediction\",\n",
    "        \"anomaly_score\",\n",
    "        \"is_anomaly\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "anomaly_output.insert(\n",
    "    0,\n",
    "    \"safetyreportid\",\n",
    "    test_ids[\"safetyreportid\"].values\n",
    ")\n",
    "\n",
    "print(\"Anomaly output shape:\", anomaly_output.shape)\n",
    "\n",
    "print(\n",
    "    \"Anomalies detected:\",\n",
    "    int(anomaly_output[\"is_anomaly\"].sum())\n",
    ")\n",
    "\n",
    "display(\n",
    "    anomaly_output\n",
    "    .sort_values(\"anomaly_score\")\n",
    "    .head(20)\n",
    ")"
   ]
