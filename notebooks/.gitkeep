   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "XGBoost version:  3.4.1\n"
     ]
    }
   ],
   "source": [
    "# %pip install xgboost\n",
    "import xgboost as xgb\n",
    "\n",
    "print(\"XGBoost version: \", xgb.__version__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1790240281991,
     "inputWidgets": {},
     "nuid": "feff2c1a-0ee6-43a6-8919-a0185452c552",
     "showTitle": false,
     "startTime": 1790240281411,
     "submitTime": 1790240224626,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "XGBoost training complete\n"
     ]
    }
   ],
   "source": [
    "xgb_model = xgb.XGBClassifier(\n",
    "    n_estimators=200,\n",
    "    max_depth=5,\n",
    "    learning_rate=0.05,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
    "    objective=\"binary:logistic\",\n",
    "    eval_metric=\"logloss\",\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "xgb_pipeline = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"model\", xgb_model)\n",
    "])\n",
    "\n",
    "xgb_pipeline.fit(X_train, y_train)\n",
    "\n",
    "print(\"XGBoost training complete\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1790240282302,
     "inputWidgets": {},
     "nuid": "7e229c4a-28fd-4e2a-9714-0f41036106da",
     "showTitle": false,
     "startTime": 1790240282015,
     "submitTime": 1790240224631,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "XGBOOST MODEL\n==================================================\nAccuracy : 0.7800\nPrecision: 0.7831\nRecall   : 0.7143\nF1       : 0.7471\nROC-AUC  : 0.8759\nPR-AUC   : 0.8803\n"
     ]
    }
   ],
   "source": [
    "xgb_pred = xgb_pipeline.predict(X_test)\n",
    "xgb_prob = xgb_pipeline.predict_proba(X_test)[:, 1]   # keep all rows (:) but grab only the second column (1) - Serious(Class 1)\n",
    "\n",
    "accuracy = accuracy_score(y_test, xgb_pred)\n",
    "precision = precision_score(y_test, xgb_pred, zero_division=0)\n",
    "recall = recall_score(y_test, xgb_pred, zero_division=0)\n",
    "f1 = f1_score(y_test, xgb_pred, zero_division=0)\n",
    "roc_auc = roc_auc_score(y_test, xgb_prob)\n",
    "pr_auc = average_precision_score(y_test, xgb_prob)\n",
    "\n",
    "print(\"XGBOOST MODEL\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"Accuracy : {accuracy:.4f}\")\n",
    "print(f\"Precision: {precision:.4f}\")\n",
    "print(f\"Recall   : {recall:.4f}\")\n",
    "print(f\"F1       : {f1:.4f}\")\n",
    "print(f\"ROC-AUC  : {roc_auc:.4f}\")\n",
    "print(f\"PR-AUC   : {pr_auc:.4f}\")"
   ]
  },
