   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training rows:  800\nTesting rows:  200\n\nTraining target distribution: \ntarget_serious\n0    437\n1    363\nName: count, dtype: int64\n\nTest target distribution: \ntarget_serious\n0    109\n1     91\nName: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y)\n",
    "\n",
    "print(\"Training rows: \", X_train.shape[0])\n",
    "print(\"Testing rows: \", X_test.shape[0])\n",
    "\n",
    "print(\"\\nTraining target distribution: \")\n",
    "print(y_train.value_counts())\n",
    "\n",
    "print(\"\\nTest target distribution: \")\n",
    "print(y_test.value_counts())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "80fe26d7-91b4-40c0-b580-371c16ee322b",
     "showTitle": false,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "source": [
    "Build the baseline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1790240280887,
     "inputWidgets": {},
     "nuid": "43f906b3-2c2d-4b0b-bb19-18c35c227145",
     "showTitle": false,
     "startTime": 1790240280619,
     "submitTime": 1790240224593,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BASELINE MODEL\n==================================================\nAccuracy : 0.5450\nPrecision: 0.0000\nRecall   : 0.0000\nF1       : 0.0000\n"
     ]
    }
   ],
   "source": [
    "from sklearn.dummy import DummyClassifier\n",
    "\n",
    "baseline = DummyClassifier(\n",
    "    strategy=\"most_frequent\"\n",
    ")\n",
    "\n",
    "baseline_pipeline = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"model\", baseline)\n",
    "])\n",
    "\n",
    "baseline_pipeline.fit(X_train, y_train)\n",
    "\n",
    "baseline_pred = baseline_pipeline.predict(X_test)\n",
    "\n",
    "baseline_accuracy = accuracy_score(y_test, baseline_pred)\n",
    "baseline_precision = precision_score(y_test, baseline_pred, zero_division=0)\n",
    "baseline_recall = recall_score(y_test, baseline_pred, zero_division=0)\n",
    "baseline_f1 = f1_score(y_test, baseline_pred, zero_division=0)\n",
    "\n",
    "print(\"BASELINE MODEL\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"Accuracy : {baseline_accuracy:.4f}\")\n",
    "print(f\"Precision: {baseline_precision:.4f}\")\n",
    "print(f\"Recall   : {baseline_recall:.4f}\")\n",
    "print(f\"F1       : {baseline_f1:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
