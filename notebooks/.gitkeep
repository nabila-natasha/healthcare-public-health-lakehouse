    "ml_results = df.loc[X_test.index, [\"safetyreportid\"]].copy()\n",
    "\n",
    "ml_results[\"actual_serious\"] = y_test.values\n",
    "ml_results[\"predicted_serious\"] = xgb_pred\n",
