    "print(df.dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "finishTime": 1790240279990,
     "inputWidgets": {},
     "nuid": "6d934652-0988-402f-a599-4898f9b2e89a",
     "showTitle": false,
     "startTime": 1790240279791,
     "submitTime": 1790240224544,
