   "source": [
    "import mlflow\n",
    "\n",
    "print(\"MLflow version: \", mlflow.__version__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "e2a778e3-2b3f-4c85-977b-beecde0a1d45",
     "showTitle": false,
