    "# Load the original ML feature dataset so we can recover safetyreportid\n",
    "\n",
    "ml_features_for_ids = pd.read_parquet(\n",
    "    \"/Volumes/workspace/default/openfda_ml/openfda_ml_features.parquet\"\n",
    ")\n",
    "\n",
    "print(\"Rows:\", len(ml_features_for_ids))\n",
    "print(\"Columns:\", ml_features_for_ids.columns.tolist())\n",
    "\n",
    "display(ml_features_for_ids[[\"safetyreportid\"]].head())"
   ]
